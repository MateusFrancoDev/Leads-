# ------------------------------------------------------------------
# Banco (Supabase PostgreSQL)
# DATABASE_URL  -> conexao via pooler (usada pela aplicacao em runtime)
# DIRECT_URL    -> conexao direta (usada apenas pelas migrations do Prisma)
# ------------------------------------------------------------------
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.PROJECT:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.PROJECT:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------
# Provider de leads
# LEAD_PROVIDER: google_places | mock
# "mock" gera dados ficticios e nao gasta API — util para desenvolver a UI.
# ------------------------------------------------------------------
LEAD_PROVIDER="mock"
GOOGLE_PLACES_API_KEY=""

# ------------------------------------------------------------------
# Controle de custo (opcionais — os defaults estao em lib/config/app-config.ts)
# ------------------------------------------------------------------
# Validade do cache de pesquisas, em horas
SEARCH_CACHE_TTL_HOURS="24"
# Requisicoes externas simultaneas
EXTERNAL_CONCURRENCY="4"
# Timeout de chamadas externas, em ms
EXTERNAL_TIMEOUT_MS="8000"
# Maximo de leads trazidos do provider por pesquisa
MAX_RESULTS_PER_SEARCH="60"

# Reenriquecimento / reanalise so acontecem depois destes prazos (em horas)
ENRICHMENT_TTL_HOURS="168"
WEBSITE_ANALYSIS_TTL_HOURS="168"
# Teto de linhas por exportacao CSV
MAX_EXPORT_ROWS="2000"

# ------------------------------------------------------------------
# IA (analise de oportunidade sob demanda)
# AI_PROVIDER: anthropic | mock | none
#   none      -> funcionalidade desligada (padrao)
#   mock      -> resposta ficticia, nao gasta token
#   anthropic -> usa a API da Anthropic
# AI_EFFORT: low | medium | high | xhigh | max  (menor = mais barato)
# ------------------------------------------------------------------
AI_PROVIDER="none"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
AI_EFFORT="low"
AI_MAX_OUTPUT_TOKENS="2000"

# Conexoes simultaneas ao banco por instancia (poolers tem limite baixo)
DB_POOL_MAX="5"

# LEAD_PROVIDER aceita tambem "openstreetmap": gratuito, sem chave e sem
# cartao. Cobertura menor que a do Google e SEM nota/avaliacoes - os filtros
# de rating ficam sem efeito nessa fonte. Exige informar a cidade na busca.
