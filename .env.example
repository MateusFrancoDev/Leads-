# ==========================================
# BANCO (PostgreSQL local do Prisma ou Supabase)
# DATABASE_URL -> conexão usada pela aplicação
# DIRECT_URL   -> conexão direta, usada apenas pelas migrations
# ==========================================
DATABASE_URL="postgresql://postgres.PROJECT:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.PROJECT:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Conexões simultâneas ao banco por instância (poolers tem limite baixo)
DB_POOL_MAX="5"

# ==========================================
# LEADS
# Só empresas reais. Nenhuma API paga e nenhuma chave necessária.
# ==========================================

LEAD_PROVIDER="openstreetmap"

# Pesquisa equivalente dentro deste prazo é respondida pelo banco
LEAD_CACHE_TTL_HOURS="168"

# Teto de estabelecimentos pedidos à fonte por pesquisa
MAX_RESULTS_PER_SEARCH="200"

# ==========================================
# OPENSTREETMAP / OVERPASS
# ==========================================

OPENSTREETMAP_ENABLED="true"

OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

OVERPASS_FALLBACK_URL="https://overpass.kumi.systems/api/interpreter"

OVERPASS_TIMEOUT_MS="15000"

# Tentativas no total, alternando entre principal e fallback
OVERPASS_MAX_ATTEMPTS="3"

# ==========================================
# NOMINATIM
# ==========================================

NOMINATIM_API_URL="https://nominatim.openstreetmap.org"

NOMINATIM_MIN_INTERVAL_MS="1100"

# ==========================================
# WEBSITE ENRICHMENT
# ==========================================

WEBSITE_CRAWLER_ENABLED="true"

WEBSITE_CRAWLER_TIMEOUT_MS="5000"

WEBSITE_CRAWLER_MAX_PAGES="3"

WEBSITE_CRAWLER_CONCURRENCY="4"

WEBSITE_CRAWLER_MAX_RESPONSE_BYTES="2000000"

# Teto de sites lidos por pesquisa
WEBSITE_CRAWLER_MAX_SITES_PER_SEARCH="40"

# Site lido / analisado há menos tempo que isto não é baixado de novo (horas)
ENRICHMENT_TTL_HOURS="168"
WEBSITE_ANALYSIS_TTL_HOURS="168"

# ==========================================
# OUTROS LIMITES
# ==========================================

# Gravações simultâneas no banco durante a busca
EXTERNAL_CONCURRENCY="4"
# Timeout do Nominatim, em ms
EXTERNAL_TIMEOUT_MS="8000"
# Teto de linhas por exportação CSV
MAX_EXPORT_ROWS="2000"

# ==========================================
# IA (análise de oportunidade sob demanda, opcional)
# AI_PROVIDER: anthropic | mock | none
#   none      -> funcionalidade desligada (padrão)
#   mock      -> resposta fictícia de análise, não gasta token
#   anthropic -> usa a API da Anthropic
# AI_EFFORT: low | medium | high | xhigh | max  (menor = mais barato)
# ==========================================
AI_PROVIDER="none"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
AI_EFFORT="low"
AI_MAX_OUTPUT_TOKENS="2000"
