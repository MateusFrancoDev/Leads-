// Schema da plataforma de captação de leads B2B.
// Os valores dos enums são espelhados em types/lead.ts (fonte única para o client).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Situação do site próprio da empresa. Rede social não conta como site.
/// Ausência do dado na fonte NÃO é prova de que a empresa não tem site:
/// esse caso é NOT_PROVIDED. NO_WEBSITE fica reservado para ausência comprovada.
enum WebsiteStatus {
  HAS_WEBSITE
  NO_WEBSITE
  NOT_PROVIDED
  INVALID_WEBSITE
  UNREACHABLE_WEBSITE
  SOCIAL_ONLY
  UNKNOWN
}

/// Confiança no WhatsApp: CONFIRMED só com link wa.me/api.whatsapp.com ou
/// etiqueta explícita na fonte; celular sozinho é apenas POSSIBLE.
enum WhatsappStatus {
  CONFIRMED
  POSSIBLE
  UNKNOWN
}

/// Resultado da leitura do site oficial (crawler).
enum EnrichmentStatus {
  PENDING
  COMPLETED
  PARTIAL
  FAILED
}

/// Estagio do lead no funil (CRM básico).
enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  RESPONDED
  INTERESTED
  PROPOSAL_SENT
  CLIENT
  DISCARDED
  INVALID
}

/// Faixa do lead score (derivada de score, ver lib/config/lead-score.ts).
enum ScoreLevel {
  LOW
  MEDIUM
  HIGH
}

/// Tipo de evento registrado no histórico do lead.
enum LeadActivityType {
  DISCOVERED
  STATUS_CHANGED
  ENRICHED
  WEBSITE_ANALYZED
  AI_ANALYZED
  NOTE
}

/// Empresa encontrada. E a entidade central: sempre reaproveitada, nunca duplicada.
model Lead {
  id String @id @default(cuid())

  /// Fonte que descobriu o lead (ex.: "openstreetmap").
  provider   String
  /// Id real na fonte (OpenStreetMap: "node/123", "way/123", "relation/123").
  externalId String?
  /// Chave única de último recurso: "fonte:externalId" (ou nome normalizado sem id).
  dedupeKey  String

  name     String
  category String?

  phone          String?
  /// Só preenchido com número confirmado (link wa.me ou etiqueta da fonte).
  whatsapp       String?
  whatsappStatus WhatsappStatus @default(UNKNOWN)
  email          String?

  website       String?
  websiteDomain String?
  websiteStatus WebsiteStatus @default(UNKNOWN)

  instagram String?
  facebook  String?
  linkedin  String?

  /// Rastreabilidade: de onde veio cada contato ("openstreetmap" | "website").
  phoneSource     String?
  whatsappSource  String?
  emailSource     String?
  websiteSource   String?
  instagramSource String?

  /// Endereço de exibição (rua + número). street/number guardam as partes.
  address      String?
  street       String?
  number       String?
  neighborhood String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  latitude     Float?
  longitude    Float?

  /// Legado do Google Places: o OpenStreetMap não tem nota nem avaliações.
  rating       Float?
  reviewsCount Int?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  /// Etiquetas originais relevantes da fonte, para auditoria.
  rawData          Json?

  score        Int        @default(0)
  scoreLevel   ScoreLevel @default(LOW)
  /// Motivos legíveis que explicam o score ao usuário.
  scoreReasons String[]   @default([])

  status     LeadStatus @default(NEW)
  isFavorite Boolean    @default(false)
  notes      String?

  /// Última vez que os dados básicos foram confirmados junto ao provider.
  lastCheckedAt DateTime?
  /// Última vez que o enriquecimento sob demanda rodou.
  enrichedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  searchResults   SearchResult[]
  activities      LeadActivity[]
  websiteAnalysis LeadWebsiteAnalysis?
  aiAnalysis      LeadAiAnalysis?
  lists           ProspectingListLead[]

  @@unique([provider, externalId])
  @@unique([dedupeKey])
  @@index([city, state])
  @@index([category])
  @@index([phone])
  @@index([websiteDomain])
  @@index([score])
  @@index([websiteStatus])
  @@index([status])
  @@index([isFavorite])
  @@index([createdAt])
}

/// Pesquisa executada. Funciona como cache: mesma chave dentro do TTL não chama a API de novo.
model Search {
  id String @id @default(cuid())

  /// Chave normalizada da busca (ex.: "openstreetmap|barbearia|osasco|sp").
  cacheKey String @unique

  term         String
  keyword      String?
  city         String?
  state        String?
  neighborhood String?
  country      String?
  radiusMeters Int?
  latitude     Float?
  longitude    Float?

  provider     String
  resultsCount Int      @default(0)
  /// Quantos elementos a fonte foi autorizada a devolver na última consulta.
  fetchLimit   Int?
  /// Quantos elementos a fonte devolveu antes da deduplicação.
  rawCount     Int      @default(0)
  /// Cidades vizinhas incluídas na busca (além de city).
  extraCities  String[] @default([])
  /// Resultados por fonte (ex.: {"openstreetmap": 3, "receita_federal": 120}).
  sourceCounts Json?
  /// Avisos das fontes (ex.: cidade ainda não importada da Receita Federal).
  warnings     String[] @default([])
  /// Quantas chamadas ao provider esta busca custou no total.
  requestCount Int      @default(0)
  /// Quantas vezes o usuário repetiu esta busca (cache hits incluídos).
  runCount     Int      @default(1)
  cacheHits    Int      @default(0)

  createdAt DateTime @default(now())
  lastRunAt DateTime @default(now())
  expiresAt DateTime

  results SearchResult[]

  @@index([lastRunAt])
  @@index([expiresAt])
}

/// Liga uma pesquisa aos leads que ela retornou, preservando a ordem do provider.
model SearchResult {
  id       String @id @default(cuid())
  searchId String
  leadId   String
  position Int

  createdAt DateTime @default(now())

  search Search @relation(fields: [searchId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([searchId, leadId])
  @@index([leadId])
}

/// Resultado da análise técnica do site (Fase 2). Criado sob demanda, nunca em massa.
model LeadWebsiteAnalysis {
  id     String @id @default(cuid())
  leadId String @unique

  finalUrl       String?
  httpStatus     Int?
  responseTimeMs Int?
  hasHttps       Boolean?
  hasViewport    Boolean?
  hasTitle       Boolean?
  hasDescription Boolean?
  hasFavicon     Boolean?
  hasContactForm Boolean?
  hasPhone       Boolean?
  hasWhatsapp    Boolean?
  hasAnalytics   Boolean?
  hasMetaPixel   Boolean?
  /// Title e meta description encontrados, para mostrar ao usuário.
  title          String?
  description    String?
  /// Hash do conteúdo relevante, para não reanalisar um site que não mudou.
  contentHash    String?
  issues         String[] @default([])

  checkedAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

/// Histórico do lead: descoberta, mudanca de status, enriquecimento.
model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  type      LeadActivityType
  /// Descrição curta e legível do evento.
  message   String
  createdAt DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

/// Área de uma cidade resolvida pelo Nominatim. A geografia quase não muda, então
/// cada cidade é geocodificada uma vez e reaproveitada por todas as buscas.
model LocationCache {
  id  String @id @default(cuid())
  /// Cidade + UF normalizadas (ex.: "osasco|sp").
  key String @unique

  city        String
  state       String
  displayName String
  /// Elemento OSM que representa a cidade (relation/way/node) e o seu id.
  osmType     String
  osmId       String
  latitude    Float
  longitude   Float
  south       Float
  north       Float
  west        Float
  east        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cópia local dos Dados Abertos do CNPJ (Receita Federal), só de empresas
/// ativas das cidades importadas. Preenchida por `npm run cnpj:import`.
model CnpjEstablishment {
  /// CNPJ completo, só dígitos.
  cnpj     String @id
  cnpjBase String

  tradeName      String?
  companyName    String?
  /// CNAE fiscal principal (7 dígitos).
  cnaeMain       String
  isHeadquarters Boolean

  streetType   String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  postalCode   String?
  state        String
  cityCode     String
  cityName     String

  phone1 String?
  phone2 String?
  email  String?

  /// Data de início de atividade (AAAAMMDD).
  startDate    String?
  /// Mês do conjunto de dados (ex.: "2026-09").
  datasetMonth String

  @@index([state, cityName, cnaeMain])
}

/// Cidades já importadas dos Dados Abertos do CNPJ.
model CnpjImportedCity {
  /// UF + nome da cidade na Receita (ex.: "SP|OSASCO").
  key          String   @id
  state        String
  cityName     String
  cityCode     String
  datasetMonth String
  rows         Int
  importedAt   DateTime @default(now())
}

/// Consumo de API por provider/operação. Base para acompanhar custo sem observabilidade pesada.
model ApiUsage {
  id        String   @id @default(cuid())
  provider  String
  operation String
  requests  Int      @default(1)
  /// Quantos itens vieram na resposta (leads, detalhes...).
  items     Int      @default(0)
  success   Boolean  @default(true)
  /// Custo estimado em dólares, quando o provider tem preço conhecido.
  costUsd   Float?
  createdAt DateTime @default(now())

  @@index([provider, operation, createdAt])
}

/// Lista de prospecção criada pelo usuário (ex.: "Clinicas sem site - Osasco").
model ProspectingList {
  id          String  @id @default(cuid())
  name        String
  /// Nome normalizado: evita duas listas com o mesmo nome.
  slug        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads ProspectingListLead[]

  @@index([updatedAt])
}

/// Vinculo entre lista e lead.
model ProspectingListLead {
  id     String  @id @default(cuid())
  listId String
  leadId String
  note   String?

  createdAt DateTime @default(now())

  list ProspectingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  lead Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([listId, leadId])
  @@index([leadId])
}

/// Análise de oportunidade gerada por IA, sob demanda.
/// Guardada com o hash da entrada: se os dados do lead não mudaram, a análise
/// e reaproveitada e nenhum token e gasto de novo.
model LeadAiAnalysis {
  id     String @id @default(cuid())
  leadId String @unique

  /// Modelo usado, para saber o que reprocessar quando trocar.
  model     String
  /// Hash dos dados enviados ao modelo.
  inputHash String

  summary       String
  problems      String[] @default([])
  opportunities String[] @default([])
  services      String[] @default([])
  approach      String

  inputTokens       Int    @default(0)
  outputTokens      Int    @default(0)
  cachedInputTokens Int    @default(0)
  costUsd           Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
