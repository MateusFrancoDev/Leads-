// Schema da plataforma de captação de leads B2B.
// Os valores dos enums são espelhados em types/lead.ts (fonte única para o client).
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Situação do site próprio da empresa. Rede social não conta como site.
/// Ausência do dado na fonte NÃO é prova de que a empresa não tem site:
/// esse caso é NOT_PROVIDED. NO_WEBSITE fica reservado para ausência comprovada.
enum WebsiteStatus {
  HAS_WEBSITE
  NO_WEBSITE
  NOT_PROVIDED
  INVALID_WEBSITE
  UNREACHABLE_WEBSITE
  SOCIAL_ONLY
  UNKNOWN
}

/// Confiança no WhatsApp: CONFIRMED só com link wa.me/api.whatsapp.com ou
/// etiqueta explícita na fonte; celular sozinho é apenas POSSIBLE.
enum WhatsappStatus {
  CONFIRMED
  POSSIBLE
  UNKNOWN
}

/// Resultado da leitura do site oficial (crawler).
enum EnrichmentStatus {
  PENDING
  COMPLETED
  PARTIAL
  FAILED
}

/// Estagio do lead no funil (CRM básico).
enum LeadStatus {
  NEW
  QUALIFIED
  CONTACTED
  RESPONDED
  INTERESTED
  PROPOSAL_SENT
  CLIENT
  DISCARDED
  INVALID
}

/// Faixa do lead score (derivada de score, ver lib/config/lead-score.ts).
/// Reaproveitada pela IA para classificar a oportunidade (alta/média/baixa).
enum ScoreLevel {
  LOW
  MEDIUM
  HIGH
}

/// Qualidade aparente do site. UNKNOWN é o padrão e continua sendo o valor
/// gravado sempre que o site não foi realmente baixado e analisado: a IA não
/// pode opinar sobre um site que ninguém abriu.
enum WebsiteQuality {
  GOOD
  AVERAGE
  POOR
  UNKNOWN
}

/// Tipo de evento registrado no histórico do lead.
enum LeadActivityType {
  DISCOVERED
  STATUS_CHANGED
  ENRICHED
  WEBSITE_ANALYZED
  AI_ANALYZED
  NOTE
}

/// Empresa encontrada. E a entidade central: sempre reaproveitada, nunca duplicada.
model Lead {
  id String @id @default(cuid())

  /// Fonte que descobriu o lead (ex.: "openstreetmap").
  provider   String
  /// Id real na fonte (OpenStreetMap: "node/123", "way/123", "relation/123").
  externalId String?
  /// Chave única de último recurso: "fonte:externalId" (ou nome normalizado sem id).
  dedupeKey  String

  name     String
  category String?

  phone          String?
  /// Só preenchido com número confirmado (link wa.me ou etiqueta da fonte).
  whatsapp       String?
  whatsappStatus WhatsappStatus @default(UNKNOWN)
  email          String?

  website       String?
  websiteDomain String?
  websiteStatus WebsiteStatus @default(UNKNOWN)

  instagram String?
  facebook  String?
  linkedin  String?

  /// Rastreabilidade: de onde veio cada contato ("openstreetmap" | "website").
  phoneSource     String?
  whatsappSource  String?
  emailSource     String?
  websiteSource   String?
  instagramSource String?

  /// Endereço de exibição (rua + número). street/number guardam as partes.
  address      String?
  street       String?
  number       String?
  neighborhood String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  latitude     Float?
  longitude    Float?

  /// Legado do Google Places: o OpenStreetMap não tem nota nem avaliações.
  rating       Float?
  reviewsCount Int?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  /// Etiquetas originais relevantes da fonte, para auditoria.
  rawData          Json?

  score        Int        @default(0)
  scoreLevel   ScoreLevel @default(LOW)
  /// Motivos legíveis que explicam o score ao usuário.
  scoreReasons String[]   @default([])

  status     LeadStatus @default(NEW)
  isFavorite Boolean    @default(false)
  notes      String?

  /// Última vez que os dados básicos foram confirmados junto ao provider.
  lastCheckedAt DateTime?
  /// Última vez que o enriquecimento sob demanda rodou.
  enrichedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  searchResults   SearchResult[]
  activities      LeadActivity[]
  websiteAnalysis LeadWebsiteAnalysis?
  aiAnalysis      LeadAiAnalysis?
  lists           ProspectingListLead[]

  @@unique([provider, externalId])
  @@unique([dedupeKey])
  @@index([city, state])
  @@index([category])
  @@index([phone])
  @@index([websiteDomain])
  @@index([score])
  @@index([websiteStatus])
  @@index([status])
  @@index([isFavorite])
  @@index([createdAt])
}

/// Pesquisa executada. Funciona como cache: mesma chave dentro do TTL não chama a API de novo.
model Search {
  id String @id @default(cuid())

  /// Chave normalizada da busca (ex.: "openstreetmap|barbearia|osasco|sp").
  cacheKey String @unique

  term         String
  keyword      String?
  city         String?
  state        String?
  neighborhood String?
  country      String?
  radiusMeters Int?
  latitude     Float?
  longitude    Float?

  provider     String
  resultsCount Int      @default(0)
  /// Quantos elementos a fonte foi autorizada a devolver na última consulta.
  fetchLimit   Int?
  /// Quantos elementos a fonte devolveu antes da deduplicação.
  rawCount     Int      @default(0)
  /// Cidades vizinhas incluídas na busca (além de city).
  extraCities  String[] @default([])
  /// Resultados por fonte (ex.: {"openstreetmap": 3, "receita_federal": 120}).
  sourceCounts Json?
  /// Avisos das fontes (ex.: cidade ainda não importada da Receita Federal).
  warnings     String[] @default([])
  /// Quantas chamadas ao provider esta busca custou no total.
  requestCount Int      @default(0)
  /// Quantas vezes o usuário repetiu esta busca (cache hits incluídos).
  runCount     Int      @default(1)
  cacheHits    Int      @default(0)

  createdAt DateTime @default(now())
  lastRunAt DateTime @default(now())
  expiresAt DateTime

  results SearchResult[]

  @@index([lastRunAt])
  @@index([expiresAt])
}

/// Liga uma pesquisa aos leads que ela retornou, preservando a ordem do provider.
model SearchResult {
  id       String @id @default(cuid())
  searchId String
  leadId   String
  position Int

  createdAt DateTime @default(now())

  search Search @relation(fields: [searchId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([searchId, leadId])
  @@index([leadId])
}

/// Resultado da análise técnica do site (Fase 2). Criado sob demanda, nunca em massa.
model LeadWebsiteAnalysis {
  id     String @id @default(cuid())
  leadId String @unique

  finalUrl       String?
  httpStatus     Int?
  responseTimeMs Int?
  hasHttps       Boolean?
  hasViewport    Boolean?
  hasTitle       Boolean?
  hasDescription Boolean?
  hasFavicon     Boolean?
  hasContactForm Boolean?
  hasPhone       Boolean?
  hasWhatsapp    Boolean?
  hasAnalytics   Boolean?
  hasMetaPixel   Boolean?
  /// Title e meta description encontrados, para mostrar ao usuário.
  title          String?
  description    String?
  /// Hash do conteúdo relevante, para não reanalisar um site que não mudou.
  contentHash    String?
  issues         String[] @default([])

  checkedAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

/// Histórico do lead: descoberta, mudanca de status, enriquecimento.
model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  type      LeadActivityType
  /// Descrição curta e legível do evento.
  message   String
  createdAt DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

/// Área de uma cidade resolvida pelo Nominatim. A geografia quase não muda, então
/// cada cidade é geocodificada uma vez e reaproveitada por todas as buscas.
model LocationCache {
  id  String @id @default(cuid())
  /// Cidade + UF normalizadas (ex.: "osasco|sp").
  key String @unique

  city        String
  state       String
  displayName String
  /// Elemento OSM que representa a cidade (relation/way/node) e o seu id.
  osmType     String
  osmId       String
  latitude    Float
  longitude   Float
  south       Float
  north       Float
  west        Float
  east        Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cópia local dos Dados Abertos do CNPJ (Receita Federal), só de empresas
/// ativas das cidades importadas. Preenchida por `npm run cnpj:import`.
model CnpjEstablishment {
  /// CNPJ completo, só dígitos.
  cnpj     String @id
  cnpjBase String

  tradeName      String?
  companyName    String?
  /// CNAE fiscal principal (7 dígitos).
  cnaeMain       String
  isHeadquarters Boolean

  streetType   String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  postalCode   String?
  state        String
  cityCode     String
  cityName     String

  phone1 String?
  phone2 String?
  email  String?

  /// Data de início de atividade (AAAAMMDD).
  startDate    String?
  /// Mês do conjunto de dados (ex.: "2026-09").
  datasetMonth String

  @@index([state, cityName, cnaeMain])
}

/// Cidades já importadas dos Dados Abertos do CNPJ.
model CnpjImportedCity {
  /// UF + nome da cidade na Receita (ex.: "SP|OSASCO").
  key          String   @id
  state        String
  cityName     String
  cityCode     String
  datasetMonth String
  rows         Int
  importedAt   DateTime @default(now())
}

/// Consumo de API por provider/operação. Base para acompanhar custo sem observabilidade pesada.
model ApiUsage {
  id        String   @id @default(cuid())
  provider  String
  operation String
  requests  Int      @default(1)
  /// Quantos itens vieram na resposta (leads, detalhes...).
  items     Int      @default(0)
  success   Boolean  @default(true)
  /// Custo estimado em dólares, quando o provider tem preço conhecido.
  costUsd   Float?
  createdAt DateTime @default(now())

  @@index([provider, operation, createdAt])
}

/// Lista de prospecção criada pelo usuário (ex.: "Clinicas sem site - Osasco").
model ProspectingList {
  id          String  @id @default(cuid())
  name        String
  /// Nome normalizado: evita duas listas com o mesmo nome.
  slug        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads ProspectingListLead[]

  @@index([updatedAt])
}

/// Vinculo entre lista e lead.
model ProspectingListLead {
  id     String  @id @default(cuid())
  listId String
  leadId String
  note   String?

  createdAt DateTime @default(now())

  list ProspectingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  lead Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([listId, leadId])
  @@index([leadId])
}

/// Análise de oportunidade gerada por IA, sob demanda.
/// Guardada com o hash da entrada: se os dados do lead não mudaram, a análise
/// e reaproveitada e nenhum token e gasto de novo.
model LeadAiAnalysis {
  id     String @id @default(cuid())
  leadId String @unique

  /// Provider que respondeu ("gemini", "anthropic", "mock").
  provider  String @default("")
  /// Modelo usado, para saber o que reprocessar quando trocar.
  model     String
  /// Hash dos dados enviados ao modelo.
  inputHash String

  /// Nota de oportunidade de 0 a 100 atribuída pela IA (independente do lead score
  /// de regras fixas, que continua em Lead.score).
  score       Int            @default(0)
  /// Faixa da nota. Sempre coerente com `score`: normalizada no servidor.
  opportunity ScoreLevel     @default(LOW)
  /// Frase curta que justifica a nota.
  scoreReason String         @default("")
  /// Só é diferente de UNKNOWN quando existe LeadWebsiteAnalysis para o lead.
  websiteQuality WebsiteQuality @default(UNKNOWN)
  /// Confiança declarada pelo modelo, de 0 a 1.
  confidence  Float          @default(0)

  summary       String
  problems      String[] @default([])
  opportunities String[] @default([])
  services      String[] @default([])
  approach      String

  inputTokens       Int    @default(0)
  outputTokens      Int    @default(0)
  cachedInputTokens Int    @default(0)
  costUsd           Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([score])
}

// ============================================================================
// SISTEMA INTERNO (CRM, projetos, financeiro, tarefas, arquivos)
//
// Valores monetários são gravados em CENTAVOS (Int). Inteiro não tem erro de
// arredondamento como Float e não exige a biblioteca decimal.js do tipo Decimal.
// Conversão e formatação ficam em lib/money.ts.
// ============================================================================

/// Papel do usuário. Hoje ADMIN e PARTNER veem tudo; EMPLOYEE já existe para
/// quando entrarem funcionários com acesso só aos projetos atribuídos.
enum UserRole {
  ADMIN
  PARTNER
  EMPLOYEE
}

/// Estágio do cliente no relacionamento comercial.
enum ClientStatus {
  LEAD
  NEGOTIATING
  ACTIVE
  COMPLETED
  INACTIVE
}

/// Tipo de serviço vendido. Novos tipos entram como valor do enum + migration.
enum ProjectType {
  LANDING_PAGE
  INSTITUTIONAL_SITE
  ECOMMERCE
  SAAS
  APP
  MAINTENANCE
  CONSULTING
  AUTOMATION
  OTHER
}

/// Etapa do projeto. A ordem aqui é a ordem das colunas do Kanban.
enum ProjectStatus {
  QUOTE
  AWAITING_APPROVAL
  AWAITING_PAYMENT
  PLANNING
  DEVELOPMENT
  REVIEW
  AWAITING_CLIENT
  COMPLETED
  CANCELLED
}

/// Prioridade de projeto e de tarefa.
enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Coluna do Kanban de tarefas.
enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

/// Situação de UM pagamento. "Atrasado" não é gravado: é derivado de
/// dueDate no passado com status PENDING (ver lib/finance.ts), assim nenhum
/// job precisa rodar para manter o banco correto.
enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  PIX
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
  CASH
  OTHER
}

enum ExpenseCategory {
  DOMAIN
  HOSTING
  API
  DATABASE
  DESIGNER
  FREELANCER
  LICENSE
  SOFTWARE
  TOOL
  OTHER
}

/// Pasta lógica do arquivo dentro do projeto.
enum FileCategory {
  BRIEFING
  CONTRACT
  DESIGN
  LOGO
  CONTENT
  DEVELOPMENT
  FINANCE
  DELIVERY
  OTHER
}

enum ContractStatus {
  NOT_SENT
  SENT
  SIGNED
}

/// O que aconteceu. Alimenta a timeline do projeto e o histórico geral.
enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  PROGRESS_CHANGED
  DEADLINE_CHANGED
  PAYMENT_REGISTERED
  PAYMENT_RECEIVED
  EXPENSE_REGISTERED
  FILE_ADDED
  FILE_REMOVED
  NOTE_ADDED
  TASK_COMPLETED
}

/// Entidade sobre a qual a atividade fala.
enum ActivityEntity {
  CLIENT
  PROJECT
  TASK
  PAYMENT
  EXPENSE
  NOTE
  FILE
  EVENT
  USER
}

/// Tipo de compromisso criado à mão no calendário.
enum EventType {
  MEETING
  DELIVERY
  REMINDER
  OTHER
}

/// Pessoa que usa o sistema. Não existe cadastro público: usuários são criados
/// pelo comando `npm run user:create`.
model User {
  id String @id @default(cuid())

  name  String
  email String @unique

  /// Hash scrypt gerado em lib/auth/password.ts. Nunca sai do servidor.
  passwordHash String

  /// Caminho do avatar dentro de storage/, quando houver.
  avatarUrl String?
  role      UserRole @default(PARTNER)

  /// Usuário desligado não consegue entrar, mas o histórico dele continua.
  isActive Boolean @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions       Session[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  createdTasks   Task[]          @relation("TaskAuthor")
  notes          Note[]
  files          StoredFile[]
  activities     Activity[]
  calendarEvents CalendarEvent[]

  @@index([email])
}

/// Sessão de login guardada no banco. O navegador só recebe o token; o banco
/// guarda o SHA-256 dele, então ler o banco não permite entrar em nome de ninguém.
model Session {
  id     String @id @default(cuid())
  userId String

  /// SHA-256 (hex) do token que está no cookie.
  tokenHash String @unique

  /// Contexto do login, para conferir acessos na tela de configurações.
  userAgent String?
  ipAddress String?

  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Cliente da empresa. Origem de todo projeto e de toda receita.
model Client {
  id String @id @default(cuid())

  name      String
  company   String?
  email     String?
  phone     String?
  whatsapp  String?
  instagram String?
  website   String?
  /// CPF ou CNPJ, só dígitos.
  document  String?
  city      String?
  state     String?

  status ClientStatus @default(LEAD)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       Project[]
  clientNotes    Note[]
  files          StoredFile[]
  calendarEvents CalendarEvent[]

  @@index([status])
  @@index([name])
  @@index([createdAt])
}

/// Trabalho vendido para um cliente. Centro do sistema: tarefas, pagamentos,
/// custos, arquivos, anotações e timeline penduram aqui.
model Project {
  id       String @id @default(cuid())
  clientId String

  name        String
  type        ProjectType @default(OTHER)
  description String?

  /// Valor cobrado do cliente, em centavos.
  valueCents         Int @default(0)
  /// Custo previsto, em centavos. O custo real vem da soma de Expense.
  estimatedCostCents Int @default(0)

  startDate DateTime?
  deadline  DateTime?
  /// Preenchido quando o status vira COMPLETED. Base dos relatórios por mês.
  completedAt DateTime?

  status   ProjectStatus @default(QUOTE)
  priority Priority      @default(NORMAL)
  /// 0 a 100. Vira 100 automaticamente ao concluir.
  progress Int           @default(0)

  technologies  String[] @default([])
  projectUrl    String?
  repositoryUrl String?
  notes         String?

  contractStatus ContractStatus @default(NOT_SENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  briefing       Briefing?
  tasks          Task[]
  payments       Payment[]
  expenses       Expense[]
  projectNotes   Note[]
  files          StoredFile[]
  activities     Activity[]
  calendarEvents CalendarEvent[]

  @@index([clientId])
  @@index([status])
  @@index([deadline])
  @@index([priority])
  @@index([type])
  @@index([createdAt])
}

/// Briefing do projeto. Um para um, criado sob demanda - nenhum campo é obrigatório.
model Briefing {
  id        String @id @default(cuid())
  projectId String @unique

  objective   String?
  audience    String?
  references  String?
  colors      String?
  style       String?
  features    String?
  competitors String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Item de trabalho dentro de um projeto.
model Task {
  id             String  @id @default(cuid())
  projectId      String
  /// Quem vai fazer. Nulo = ainda sem responsável.
  assignedUserId String?
  /// Quem criou, para o histórico.
  createdById    String?

  title       String
  description String?

  priority Priority   @default(NORMAL)
  status   TaskStatus @default(TODO)
  deadline DateTime?
  /// Momento em que a tarefa entrou em DONE.
  completedAt DateTime?

  /// Posição dentro da coluna do Kanban (menor primeiro).
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  author   User?   @relation("TaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([assignedUserId, status])
  @@index([deadline])
  @@index([status, position])
}

/// Parcela a receber de um projeto. Um projeto pode ter várias
/// (entrada + parcelas); os totais do projeto são a soma delas.
model Payment {
  id        String @id @default(cuid())
  projectId String

  description String?
  /// Valor da parcela, em centavos.
  amountCents Int
  method      PaymentMethod @default(PIX)

  dueDate DateTime?
  paidAt  DateTime?
  status  PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status, dueDate])
  @@index([paidAt])
}

/// Gasto ligado a um projeto (domínio, hospedagem, freelancer...).
model Expense {
  id        String @id @default(cuid())
  projectId String

  description String
  category    ExpenseCategory @default(OTHER)
  /// Valor pago, em centavos.
  amountCents Int
  date        DateTime        @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([category])
  @@index([date])
}

/// Anotação livre presa a um cliente e/ou a um projeto.
model Note {
  id        String  @id @default(cuid())
  projectId String?
  clientId  String?
  userId    String?

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([clientId, createdAt])
}

/// Arquivo guardado pelo sistema. O binário fica em disco (pasta storage/, fora
/// do versionamento); aqui ficam só os metadados e o caminho relativo.
/// Chama-se StoredFile e não File para não colidir com o File do navegador.
model StoredFile {
  id        String  @id @default(cuid())
  projectId String?
  clientId  String?
  userId    String?

  /// Nome original, mostrado na interface.
  name String
  /// Caminho relativo dentro de storage/ (nunca exposto ao navegador).
  path String
  /// Content-Type declarado no upload.
  mimeType  String
  sizeBytes Int
  category  FileCategory @default(OTHER)

  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([clientId, createdAt])
  @@index([category])
}

/// Quem fez o quê. Gravada pelos services, nunca à mão pela interface.
/// Alimenta a timeline do projeto e a página de histórico.
model Activity {
  id     String  @id @default(cuid())
  userId String?
  /// Preenchido quando a ação aconteceu dentro de um projeto, para a timeline.
  projectId String?

  entityType ActivityEntity
  entityId   String
  action     ActivityAction
  /// Frase pronta, em português, com nome e valores já embutidos.
  description String

  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Compromisso criado à mão (reunião, entrega). Prazos de projeto, prazos de
/// tarefa e vencimentos de pagamento NÃO viram registro aqui: o calendário os
/// lê direto das tabelas de origem, para nunca ficarem dessincronizados.
model CalendarEvent {
  id        String  @id @default(cuid())
  projectId String?
  clientId  String?
  userId    String?

  title       String
  description String?
  type        EventType @default(MEETING)
  startsAt    DateTime
  /// Compromisso de dia inteiro ignora a hora de startsAt.
  allDay Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([projectId])
}

/// Dados da própria empresa. Linha única (id fixo "app"): não é multiempresa.
model AppSettings {
  id String @id @default("app")

  companyName String  @default("Lummit")
  logoUrl     String?

  updatedAt DateTime @updatedAt
}
